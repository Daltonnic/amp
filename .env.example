# Copy to .env.local and fill in. Without the two Supabase values the app runs
# in on-device mode (data stays in the browser) — handy for local development.

# Supabase → Project Settings → API keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Shown in Settings and the Privacy Policy
VITE_SUPPORT_EMAIL=support@example.org

# Public URL of the PWA (optional)
VITE_PUBLIC_WEB_URL=https://app.example.org

# Shown in Settings → About
VITE_APP_VERSION=1.0.0

# Push notifications in the store apps (needs Firebase + an Apple push key first;
# see docs/PUSH_NOTIFICATIONS.md). Browsers and Home Screen apps don't need this.
# VITE_NATIVE_PUSH=true

# Only if you replace the Web Push key pair (see docs/PUSH_NOTIFICATIONS.md).
# VITE_VAPID_PUBLIC_KEY=
